{
  "name": "gatus-fe",
  "private": true,
  "version": "0.1.0",
  "description": "Anthropic-inspired status page UI for Gatus",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SheathedSharp/gatus-fe.git"
  },
  "bugs": {
    "url": "https://github.com/SheathedSharp/gatus-fe/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name gatus-fe"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  }
}
