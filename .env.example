# Gatus 后端地址（Vite dev 代理 / Pages Function 使用）
GATUS_API_BASE=https://monitor.example.com

# 生产构建：前端直连的 Pages Function 地址（Pages 项目的 pages.dev 域名）
VITE_API_BASE=https://your-project.pages.dev

# 页面展示的站点域名与页脚外链
VITE_SITE_HOST=status.example.com
VITE_SITE_URL=https://example.com

# 后端受 Cloudflare Access（Zero Trust）保护时配置（可选）
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
